.DS_Store
Thumbs.db
.env
.env.*
!.env.example
node_modules/
__pycache__/
*.pyc
# Type files Claude Code writes on each load of a mod
.claude-plugin/types/

# Claude Code worktrees, made per session
.claude/worktrees/

# Each person's own Claude Code settings for this repo
.claude/settings.local.json

# A plugin's TypeScript runs as source. JavaScript next to it is compiler output, never committed.
plugins/*/hooks/*.js
plugins/*/tests/*.js
plugins/*/types/*.js
