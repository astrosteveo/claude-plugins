{
  "type": "object",
  "properties": {
    "summary": { "type": "string", "description": "One paragraph: what will be built and the key design decision." },
    "approach": { "type": "string", "description": "Why this approach over the alternatives considered." },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "files": { "type": "array", "items": { "type": "string" } },
          "details": { "type": "string" },
          "verification": { "type": "string" }
        },
        "required": ["title", "files", "details", "verification"],
        "additionalProperties": false
      }
    },
    "risks": { "type": "array", "items": { "type": "string" } },
    "open_questions": { "type": "array", "items": { "type": "string" } },
    "estimated_effort": { "type": "string" }
  },
  "required": ["summary", "approach", "steps", "risks", "open_questions", "estimated_effort"],
  "additionalProperties": false
}
