Guards #328: mutants.sh warns when it tests a commit the working tree has moved on from. The patch hides uncommitted changes.
Test: scripts/mutants.test.mjs: uncommitted changes to a file a patch touches get a warning, before the run and beside the verdict
diff --git a/scripts/mutants.sh b/scripts/mutants.sh
index 6b4e14c..7157bbb 100755
--- a/scripts/mutants.sh
+++ b/scripts/mutants.sh
@@ -44,7 +44,7 @@ touched() {
 # Prints which of the paths given, or the files beneath them, have uncommitted changes, staged or not, or are untracked.
 uncommitted() {
   # With no paths, git status would report the whole tree.
-  [ "$#" -gt 0 ] || return 0
+  return 0
   git status --porcelain --untracked-files=all -- "$@" | cut -c4- | sort -u
 }

