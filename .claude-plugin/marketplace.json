  "name": "astrosteveo-plugins",
  "description": "Claude Code mods by astrosteveo.",
  "owner": {
    "name": "astrosteveo",
    "url": "https://github.com/astrosteveo"
  },
  "plugins": [
    {
      "name": "ask",
      "source": "./plugins/ask",
      "description": "Ask Claude a side question in a pane, and get Claude's own pick, remembered answers and a decision log when Claude asks you.",
      "version": "0.3.4",
      "author": {
        "name": "astrosteveo"
      },
      "homepage": "https://github.com/astrosteveo/claude-plugins/tree/main/plugins/ask",
      "category": "productivity",
      "tags": [
        "mod",
        "ask",
        "side-question",
        "prompts",
        "pane"
      ]
    },
    {
      "name": "usage",
      "source": "./plugins/usage",
      "description": "Context fill, cost and rate limits in a band above the prompt, each turn's tokens and cost on the line that closes it, and a /spend pane.",
      "version": "0.2.2",
      "author": {
        "name": "astrosteveo"
      },
      "homepage": "https://github.com/astrosteveo/claude-plugins/tree/main/plugins/usage",
      "category": "productivity",
      "tags": [
        "mod",
        "usage",
        "cost",
        "tokens",
        "context"
      ]
    },
    {
      "name": "gutter",
      "source": "./plugins/gutter",
      "description": "A time column at the right of the transcript: when you sent each prompt, how long each tool ran, and each folded group's total.",
      "version": "0.1.1",
      "author": {
        "name": "astrosteveo"
      },
      "homepage": "https://github.com/astrosteveo/claude-plugins/tree/main/plugins/gutter",
      "category": "productivity",
      "tags": [
        "mod",
        "transcript",
        "timing",
        "tools"
      ]
    },
    {
      "name": "minimap",
      "source": "./plugins/minimap",
      "description": "The whole session as a strip of colored cells above the prompt: what each turn did, what it cost, and where it failed, and a /minimap pane.",
      "version": "0.2.1",
      "author": {
        "name": "astrosteveo"
      },
      "homepage": "https://github.com/astrosteveo/claude-plugins/tree/main/plugins/minimap",
      "category": "productivity",
      "tags": [
        "mod",
        "transcript",
        "minimap",
        "cost"
      ]
    },
    {
      "name": "worktree",
      "source": "./plugins/worktree",
      "description": "Asks once, before Claude's first edit on the default branch, whether to move the work into a git worktree, and a /wt pane.",
      "version": "0.3.0",
      "author": {
        "name": "astrosteveo"
      },
      "homepage": "https://github.com/astrosteveo/claude-plugins/tree/main/plugins/worktree",
      "category": "productivity",
      "tags": [
        "mod",
        "git",
        "worktree",
        "branches"
      ]
